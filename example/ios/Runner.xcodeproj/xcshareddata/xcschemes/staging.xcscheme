               title = "Run Script"
               scriptText = "exec &gt; ${PROJECT_DIR}/prebuild.log 2&gt;&amp;1;&#10;SCRIPT_PATH=&quot;${SRCROOT}/.symlinks/plugins/flutter_config/ios/Classes/BuildXCConfig.rb&quot;&#10;if [ ! -f &quot;$SCRIPT_PATH&quot; ]; then SCRIPT_PATH=&quot;${SRCROOT}/Flutter/ephemeral/Packages/.packages/flutter_config/Sources/flutter_config/BuildXCConfig.rb&quot;; fi&#10;if [ ! -f &quot;$SCRIPT_PATH&quot; ]; then SCRIPT_PATH=&quot;${SRCROOT}/../../ios/Classes/BuildXCConfig.rb&quot;; fi&#10;if [ -f &quot;$SCRIPT_PATH&quot; ]; then ruby &quot;$SCRIPT_PATH&quot; &quot;${SRCROOT}/&quot; &quot;${SRCROOT}/Flutter/tmp.xcconfig&quot;; fi&#10;PLIST_SCRIPT=&quot;${SRCROOT}/.symlinks/plugins/flutter_config/ios/Classes/BuildDotenvPlist.rb&quot;&#10;if [ ! -f &quot;$PLIST_SCRIPT&quot; ]; then PLIST_SCRIPT=&quot;${SRCROOT}/Flutter/ephemeral/Packages/.packages/flutter_config/Sources/flutter_config/BuildDotenvPlist.rb&quot;; fi&#10;if [ ! -f &quot;$PLIST_SCRIPT&quot; ]; then PLIST_SCRIPT=&quot;${SRCROOT}/../../ios/Classes/BuildDotenvPlist.rb&quot;; fi&#10;if [ -f &quot;$PLIST_SCRIPT&quot; ]; then ruby &quot;$PLIST_SCRIPT&quot; &quot;${SRCROOT}/&quot; &quot;${SRCROOT}/Flutter/GeneratedDotEnv.plist&quot;; fi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "97C146ED1CF9000F007C117D"
                     BuildableName = "Runner.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
